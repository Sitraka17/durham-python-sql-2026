# Credentials
.env

# Generated databases (run setup_db.py to regenerate)
db/*.db

# Generated outputs (run pipeline.py / analysis.py to regenerate)
# Keep the folder (.gitkeep) but ignore its generated contents.
outputs/*
!outputs/.gitkeep
*.png
*.pdf

# Runtime-derived dataset copies (download.py regenerates these from the
# committed *_static.csv bundles). The static bundles ARE committed.
datasets/fred_rates.csv
datasets/oecd_unemployment.csv

# Synthetic demo data auto-generated by capstone/track_a/analysis.py when
# absent (students replace it with real ONS data). Not committed.
datasets/uk_ons_labour.csv

# Raw API-response cache used only by datasets/_build_static_csvs.py
datasets/.cache/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
env/
venv/
*.egg-info/
dist/
build/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# OS
.DS_Store
Thumbs.db
desktop.ini

# VS Code (keep workspace file, ignore per-user settings)
.vscode/settings.json
.vscode/launch.json

# Instructor-only materials (kept in private fork only)
instructor/

# Instructor-only model answers — generated locally, NOT published until after
# the course. Delete this block (or use a private fork) to distribute them.
solutions/*
!solutions/.gitkeep
