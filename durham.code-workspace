{
  "folders": [{ "path": "." }],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "editor.formatOnSave": true,
    "editor.rulers": [88],
    "editor.tabSize": 4,
    "files.exclude": {
      "**/__pycache__": true,
      "**/.ipynb_checkpoints": true
    },
    "sqliteViewer.maxTextLength": 2000,
    "[python]": {
      "editor.defaultFormatter": "ms-python.python"
    },
    "[sql]": {
      "editor.defaultFormatter": "adpyke.codesnap"
    }
  },
  "extensions": {
    "recommendations": [
      "qwtel.sqlite-viewer",
      "ms-python.python",
      "ms-toolsai.jupyter",
      "eamodio.gitlens"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Run pipeline.py",
        "type": "python",
        "request": "launch",
        "program": "${workspaceFolder}/scripts/pipeline.py",
        "console": "integratedTerminal"
      },
      {
        "name": "Run financial_indicators.py",
        "type": "python",
        "request": "launch",
        "program": "${workspaceFolder}/scripts/financial_indicators.py",
        "console": "integratedTerminal"
      }
    ]
  }
}
